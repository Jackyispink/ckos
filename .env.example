# 书生 ChatAPI：填入个人 token，不需要 Bearer 前缀
LLM_CHAT_URL=https://chat.intern-ai.org.cn/api/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=intern-s1-mini
LLM_TIMEOUT=150
LLM_MAX_TOKENS=3000
# 留空使用服务端默认；支持的模型可填写 true 或 false
LLM_THINKING_MODE=false

# Pluggable web search. Add another adapter, then change WEB_SEARCH_PROVIDER to switch vendors.
WEB_SEARCH_PROVIDER=exa
EXA_API_KEY=
EXA_SEARCH_URL=https://api.exa.ai/search
# Only retry transient transport failures. 0 disables; values above 1 are capped at 1 to limit duplicate billing risk.
EXA_TRANSPORT_MAX_RETRIES=1
EXA_RETRY_BASE_DELAY_SECONDS=0.25
EXA_RETRY_JITTER_SECONDS=0.10

# PostgreSQL connection; DATABASE_URL can alternatively provide the full DSN.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ckos
PGUSER=postgres
PGPASSWORD=
